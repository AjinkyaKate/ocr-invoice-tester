# Free keys. The app reads invoice fields with the first one that works, in this order:
GOOGLE_GENERATIVE_AI_API_KEY=  # https://aistudio.google.com/apikey   (free tier)
OPENROUTER_API_KEY=            # https://openrouter.ai/settings/keys  (50 free requests/day)
GROQ_API_KEY=                  # https://console.groq.com/keys        (about 1,000 free requests/day)
# OCR: locally the PaddleOCR server (npm run ocr). On a hosted deploy set OCR_PROVIDER=ocrspace.
OCR_PROVIDER=
OCR_SPACE_API_KEY=             # https://ocr.space/ocrapi/freekey
