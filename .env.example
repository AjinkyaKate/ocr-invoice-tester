# Copy this file to .env and fill only the providers you want to test.
# Never commit real keys.

# Debugging
# Set to 1 only when investigating provider-specific behavior.
OCR_SAVE_RAW_PROVIDER_RESPONSES=0

# OCR.space
OCR_SPACE_API_KEY=
OCR_SPACE_ENDPOINT=https://api.ocr.space/parse/image
OCR_SPACE_LANGUAGE=eng
OCR_SPACE_ENGINE=2
OCR_SPACE_COST_PER_PAGE=0

# Azure AI Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_API_VERSION=2024-11-30
AZURE_DOCUMENT_INTELLIGENCE_COST_PER_PAGE=0

# Google Cloud Vision OCR
# Preferred for Postman: use a short-lived OAuth token from gcloud auth print-access-token.
GOOGLE_OAUTH_ACCESS_TOKEN=
GOOGLE_CLOUD_PROJECT=
# Optional fallback if your Google Cloud setup allows API key auth for Vision API.
GOOGLE_CLOUD_VISION_API_KEY=
GOOGLE_VISION_COST_PER_PAGE=0

# Gemini Flash multimodal OCR-like extraction
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=120
GEMINI_COST_PER_REQUEST=0

# AWS Textract
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_TEXTRACT_COST_PER_PAGE=0

# Mistral OCR
MISTRAL_API_KEY=
MISTRAL_OCR_ENDPOINT=https://api.mistral.ai/v1/ocr
MISTRAL_FILES_ENDPOINT=https://api.mistral.ai/v1/files
MISTRAL_FILE_PURPOSE=ocr
MISTRAL_SIGNED_URL_EXPIRY=24
MISTRAL_OCR_COST_PER_PAGE=0
# Optional: if local files are also hosted at a temporary/signed public base URL.
MISTRAL_PUBLIC_BASE_URL=

# ScrapeGraphAI
# ScrapeGraph v2 scrape fetches public URLs. Use --file https://... or set SCRAPEGRAPH_PUBLIC_BASE_URL.
SGAI_API_KEY=
SGAI_API_URL=https://v2-api.scrapegraphai.com/api
SCRAPEGRAPH_PUBLIC_BASE_URL=
SCRAPEGRAPH_MARKDOWN_MODE=normal
SCRAPEGRAPH_CONTENT_TYPE=
SCRAPEGRAPH_TIMEOUT=120
SCRAPEGRAPH_COST_PER_REQUEST=0

# Local Tesseract CLI
TESSERACT_LANG=eng
TESSERACT_EXTRA_ARGS=
